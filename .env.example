# Copy to .env and fill in the two required secrets.
# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT signing secret (>= 32 random hex characters)
JWT_SECRET=

# 32-byte key (64 hex chars) used to encrypt device credentials at rest.
# WARNING: if you lose this key, stored device credentials become unreadable.
# Generate inside the backend folder with: npm run gen:key
CREDENTIAL_KEY=

# Session lifetime
JWT_EXPIRES_IN=12h

# Public URL of the UI (used for CORS)
CORS_ORIGIN=http://localhost:8080

# Port published for the web UI
HTTP_PORT=8080

# Device automation tuning
SSH_READY_TIMEOUT_MS=20000
SSH_COMMAND_TIMEOUT_MS=60000
SSH_LONG_COMMAND_TIMEOUT_MS=180000
JOB_CONCURRENCY=5

# RESTCONF driver: verify device TLS certificates (self-signed usually false)
RESTCONF_VERIFY_TLS=false

LOG_LEVEL=info
