# ---------------------------------------------------------------------------
# Network Automation Center - backend environment
# Copy this file to .env and adjust the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# HTTP port for the API
PORT=5000

# MongoDB connection string (use the docker service name "mongo" inside compose)
MONGODB_URI=mongodb://127.0.0.1:27017/network_automation

# JWT signing secret (>= 32 random characters in production)
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# 32-byte key (64 hex chars) used to encrypt device credentials at rest.
# Generate with: npm run gen:key
CREDENTIAL_KEY=

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# SSH behaviour
SSH_READY_TIMEOUT_MS=20000
SSH_COMMAND_TIMEOUT_MS=60000
SSH_LONG_COMMAND_TIMEOUT_MS=180000

# Number of devices processed in parallel by a job / scheduled backup
JOB_CONCURRENCY=5

# RESTCONF driver: verify TLS certificates (self-signed device certs usually false)
RESTCONF_VERIFY_TLS=false

# Bootstrap admin (used by: npm run seed:admin)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Logging
LOG_LEVEL=info
